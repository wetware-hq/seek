{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wetwarehq.github.io/seek/schema/frame.schema.json",
  "title": "Seek frame",
  "description": "Sequence representation frame for one informational polymer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "topo",
    "seq",
    "features",
    "want",
    "forbid",
    "phase"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable frame identifier (e.g. frm_001)."
    },
    "kind": {
      "type": "string",
      "enum": ["DNA", "RNA", "AA", "XNA"]
    },
    "topo": {
      "type": "string",
      "enum": ["linear", "circular"]
    },
    "seq": {
      "type": "string",
      "description": "Primary sequence; empty string is legal."
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "want": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbid": {
      "type": "array",
      "items": { "type": "string" }
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "description": "Lifecycle phase (e.g. spec, draft, locked)."
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Feature kind (e.g. CDS, primer, locus)."
        },
        "start": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based inclusive start on seq when seq is nonempty."
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based inclusive end on seq when seq is nonempty."
        },
        "strand": {
          "type": "string",
          "enum": ["+", "-"]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Child frame id for composite loci."
        }
      }
    },
    "feature_on_seq": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        { "required": ["type", "start", "end"] }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "seq": { "type": "string", "minLength": 1 }
        },
        "required": ["seq"]
      },
      "then": {
        "properties": {
          "features": {
            "items": { "$ref": "#/$defs/feature_on_seq" }
          }
        }
      }
    }
  ]
}
